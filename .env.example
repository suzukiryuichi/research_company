# Copy this file to .env and set your lab API key locally.
# Never share the populated .env file or include it in a ZIP/Git commit.
RESEARCH_PROVIDER=qwen
RESEARCH_BASE_URL=https://haisoft.comp.ae.keio.ac.jp/v1
RESEARCH_MODEL=qwen3.8-27b
RESEARCH_API_KEY=
# Qwen mode crawls official sites and reads text PDFs. Choose 12/24/40 pages
# and add separate official careers/IR URLs in the research form.
# To use OpenAI Web search instead, set RESEARCH_PROVIDER=openai,
# RESEARCH_MODEL=gpt-4.1 and use an OpenAI API key.
